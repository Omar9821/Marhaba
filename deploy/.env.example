# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى أي مكان.

# العنوان: نطاق عام لتفعيل HTTPS تلقائيًا، أو عنوان الشبكة الداخلية مع SITE_ADDRESS=:80
SITE_ADDRESS=app.example.dz
PUBLIC_URL=https://app.example.dz

# قاعدة البيانات (كلمة مرور قوية، حروف وأرقام فقط تجنبًا لمشاكل الرابط)
MONGO_USER=marhaba
MONGO_PASSWORD=غيّرها
DB_NAME=marhaba

# أسرار التطبيق
JWT_SECRET=غيّرها-بنص-عشوائي-طويل
# عند نقل بيانات من السحابة: يجب أن يكون نفس ENCRYPTION_KEY القديم تمامًا، وإلا تتعذر قراءة الهواتف والرواتب المشفّرة
ENCRYPTION_KEY=

# حسابا الدخول الأوليان (يُنشآن أو يُحدَّثان عند كل تشغيل)
ADMIN_EMAIL=admin@company.dz
ADMIN_PASSWORD=غيّرها
OWNER_EMAIL=owner@company.dz
OWNER_PASSWORD=غيّرها
MAIN_BRANCH_NAME=الورشة

# الإشعارات (اختياري): انسخ المفاتيح نفسها من السحابة، وVAPID_SUBJECT = PUBLIC_URL
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://app.example.dz
